diff --git a/vagrant-support/libvirt.rb b/vagrant-support/libvirt.rb
new file mode 100644
index 0000000..74be0c0
--- /dev/null
+++ b/vagrant-support/libvirt.rb
@@ -0,0 +1,275 @@
+# frozen_string_literal: true
+
+require "ipaddr"
+require "open3"
+require "rexml/document"
+require "socket"
+
+module K8sWorkshop
+  MGMT_NETWORK_NAME = "k8s-workshop-mgmt"
+  LAB_NETWORK_NAME = "k8s-workshop"
+  SUPPORTED_SYNC_TYPES = %w[auto 9p virtiofs nfs].freeze
+  RFC1918_NETWORKS = [
+    IPAddr.new("10.0.0.0/8"),
+    IPAddr.new("172.16.0.0/12"),
+    IPAddr.new("192.168.0.0/16")
+  ].freeze
+
+  Network = Struct.new(:name, :cidr, :forward_mode, :dhcp, keyword_init: true)
+
+  module_function
+
+  def parse_private_slash24!(value, variable_name)
+    cidr = IPAddr.new(value)
+    prefix = value.to_s.split("/", 2)[1]
+    unless cidr.ipv4? && prefix == "24" && RFC1918_NETWORKS.any? { |range| range.include?(cidr.to_range.begin) && range.include?(cidr.to_range.end) }
+      raise ArgumentError, "#{variable_name} must be a private IPv4 /24 CIDR (received #{value.inspect})"
+    end
+
+    canonical = "#{cidr.to_range.begin}/24"
+    unless canonical == value
+      raise ArgumentError, "#{variable_name} must use the network address #{canonical} (received #{value.inspect})"
+    end
+
+    cidr
+  rescue IPAddr::InvalidAddressError
+    raise ArgumentError, "#{variable_name} is not a valid CIDR (received #{value.inspect})"
+  end
+
+  def host_address(network, host_number)
+    raise ArgumentError, "host number must be between 1 and 254" unless (1..254).cover?(host_number)
+
+    IPAddr.new(network.to_i + host_number, Socket::AF_INET).to_s
+  end
+
+  def cidr_string(network)
+    "#{network.to_range.begin}/#{network.prefix}"
+  end
+
+  def overlap?(left, right)
+    left.include?(right.to_range.begin) || right.include?(left.to_range.begin)
+  end
+
+  module SyncedFolder
+    module_function
+
+    def resolve(requested)
+      unless SUPPORTED_SYNC_TYPES.include?(requested)
+        raise ArgumentError,
+              "K8S_LAB_SYNCED_FOLDER must be one of #{SUPPORTED_SYNC_TYPES.join(', ')} (received #{requested.inspect})"
+      end
+
+      return requested unless requested == "auto"
+      return "virtiofs" if virtiofsd_path
+      return "nfs" if nfs_ready?
+
+      "9p"
+    end
+
+    def validate_available!(selected)
+      case selected
+      when "virtiofs"
+        return true if virtiofsd_path
+
+        raise "K8S_LAB_SYNCED_FOLDER=virtiofs requires an executable virtiofsd on the host"
+      when "nfs"
+        return true if nfs_ready?
+
+        raise "K8S_LAB_SYNCED_FOLDER=nfs requires exportfs and an active NFS service on TCP port 2049"
+      when "9p"
+        true
+      else
+        raise ArgumentError, "unsupported resolved synced-folder backend #{selected.inspect}"
+      end
+    end
+
+    def virtiofsd_path
+      candidates = [executable_on_path("virtiofsd")]
+      candidates.concat(%w[/usr/lib/virtiofsd /usr/libexec/virtiofsd /usr/lib/qemu/virtiofsd])
+      candidates.compact!
+      candidates.find { |path| File.file?(path) && File.executable?(path) }
+    end
+
+    def nfs_ready?
+      exportfs_path = executable_on_path("exportfs")
+      exportfs_path ||= %w[/usr/sbin/exportfs /sbin/exportfs].find do |path|
+        File.file?(path) && File.executable?(path)
+      end
+      return false unless exportfs_path
+
+      tcp_service_ready?("localhost", 2049)
+    end
+
+    def tcp_service_ready?(host, port)
+      Socket.tcp(host, port, connect_timeout: 1) { |socket| socket.close }
+      true
+    rescue SocketError, SystemCallError
+      false
+    end
+
+    def executable_on_path(name)
+      extensions = [""]
+      if File::ALT_SEPARATOR
+        extensions.concat(ENV.fetch("PATHEXT", ".COM;.EXE;.BAT;.CMD").split(File::PATH_SEPARATOR))
+      end
+
+      ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |directory|
+        next if directory.empty?
+
+        extensions.each do |extension|
+          candidate = File.join(directory, "#{name}#{extension}")
+          return candidate if File.file?(candidate) && File.executable?(candidate)
+        end
+      end
+
+      nil
+    end
+  end
+
+  module LibvirtPreflight
+    module_function
+
+    def run!(management_cidr:, lab_cidr:, synced_folder_type:)
+      K8sWorkshop::SyncedFolder.validate_available!(synced_folder_type)
+      puts "Kubernetes workshop libvirt synced-folder backend: #{synced_folder_type}"
+
+      desired = {
+        MGMT_NETWORK_NAME => Network.new(
+          name: MGMT_NETWORK_NAME,
+          cidr: management_cidr,
+          forward_mode: "nat",
+          dhcp: true
+        ),
+        LAB_NETWORK_NAME => Network.new(
+          name: LAB_NETWORK_NAME,
+          cidr: lab_cidr,
+          forward_mode: "none",
+          dhcp: false
+        )
+      }
+
+      validate_inventory!(desired, libvirt_networks, host_routes)
+      puts "Libvirt network preflight passed: #{K8sWorkshop.cidr_string(management_cidr)} (NAT), " \
+           "#{K8sWorkshop.cidr_string(lab_cidr)} (isolated)"
+    end
+
+    def validate_inventory!(desired, networks, routes)
+      wanted = desired.values
+      if K8sWorkshop.overlap?(wanted[0].cidr, wanted[1].cidr)
+        raise "K8S_LAB_MGMT_NETWORK #{K8sWorkshop.cidr_string(wanted[0].cidr)} overlaps " \
+              "K8S_LAB_PRIVATE_NETWORK #{K8sWorkshop.cidr_string(wanted[1].cidr)}"
+      end
+
+      reusable_cidrs = []
+      networks.each do |existing|
+        matching_name = desired[existing.name]
+        if matching_name
+          validate_named_network!(matching_name, existing)
+          reusable_cidrs << existing.cidr
+          next
+        end
+
+        wanted.each do |requested|
+          next unless K8sWorkshop.overlap?(requested.cidr, existing.cidr)
+
+          raise collision_message(
+            requested,
+            "libvirt network #{existing.name.inspect} at #{K8sWorkshop.cidr_string(existing.cidr)}"
+          )
+        end
+      end
+
+      routes.each do |route|
+        next if reusable_cidrs.any? do |cidr|
+          cidr.include?(route.to_range.begin) && cidr.include?(route.to_range.end)
+        end
+
+        wanted.each do |requested|
+          next unless K8sWorkshop.overlap?(requested.cidr, route)
+
+          raise collision_message(requested, "host route #{K8sWorkshop.cidr_string(route)}")
+        end
+      end
+
+      true
+    end
+
+    def validate_named_network!(requested, existing)
+      problems = []
+      same_cidr = existing.cidr.to_i == requested.cidr.to_i &&
+        existing.cidr.prefix == requested.cidr.prefix
+      unless same_cidr
+        problems << "CIDR #{K8sWorkshop.cidr_string(existing.cidr)} instead of #{K8sWorkshop.cidr_string(requested.cidr)}"
+      end
+      problems << "forward mode #{existing.forward_mode.inspect} instead of #{requested.forward_mode.inspect}" unless existing.forward_mode == requested.forward_mode
+      problems << "DHCP #{existing.dhcp ? 'enabled' : 'disabled'} instead of #{requested.dhcp ? 'enabled' : 'disabled'}" unless existing.dhcp == requested.dhcp
+      return if problems.empty?
+
+      raise "libvirt network #{requested.name.inspect} already exists with incompatible settings: #{problems.join('; ')}"
+    end
+
+    def collision_message(requested, conflict)
+      variable = requested.name == MGMT_NETWORK_NAME ? "K8S_LAB_MGMT_NETWORK" : "K8S_LAB_PRIVATE_NETWORK"
+      example = requested.name == MGMT_NETWORK_NAME ? "172.28.240.0/24" : "192.168.77.0/24"
+      "requested #{requested.name} network #{K8sWorkshop.cidr_string(requested.cidr)} overlaps #{conflict}. " \
+        "Choose another unused private /24, for example: #{variable}=#{example} vagrant up --provider=libvirt"
+    end
+
+    def libvirt_networks
+      stdout, stderr, status = Open3.capture3("virsh", "net-list", "--all", "--name")
+      raise "unable to query libvirt networks: #{stderr.strip}" unless status.success?
+
+      stdout.lines.filter_map do |line|
+        name = line.strip
+        next if name.empty?
+
+        xml, xml_stderr, xml_status = Open3.capture3("virsh", "net-dumpxml", name)
+        raise "unable to inspect libvirt network #{name.inspect}: #{xml_stderr.strip}" unless xml_status.success?
+
+        parse_network_xml(name, xml)
+      end.compact
+    rescue Errno::ENOENT
+      raise "virsh is required for the libvirt network preflight"
+    end
+
+    def parse_network_xml(name, xml)
+      document = REXML::Document.new(xml)
+      ip_element = REXML::XPath.first(document, "/network/ip[@address]")
+      return nil unless ip_element
+
+      address = ip_element.attributes["address"]
+      prefix = ip_element.attributes["prefix"]
+      mask = ip_element.attributes["netmask"]
+      cidr = IPAddr.new("#{address}/#{prefix || mask}")
+      cidr = IPAddr.new("#{cidr.to_range.begin}/#{prefix || mask}")
+      forward = REXML::XPath.first(document, "/network/forward")
+      dhcp = !REXML::XPath.first(document, "/network/ip/dhcp").nil?
+
+      Network.new(
+        name: name,
+        cidr: cidr,
+        forward_mode: forward ? forward.attributes["mode"].to_s : "none",
+        dhcp: dhcp
+      )
+    rescue REXML::ParseException, IPAddr::InvalidAddressError => e
+      raise "unable to parse libvirt network #{name.inspect}: #{e.message}"
+    end
+
+    def host_routes
+      stdout, stderr, status = Open3.capture3("ip", "-o", "-4", "route", "show", "table", "all")
+      raise "unable to query host routes: #{stderr.strip}" unless status.success?
+
+      stdout.lines.filter_map do |line|
+        token = line.split.find { |part| part.match?(/\A\d+\.\d+\.\d+\.\d+(?:\/\d+)?\z/) }
+        next unless token
+
+        token += "/32" unless token.include?("/")
+        IPAddr.new(token)
+      rescue IPAddr::InvalidAddressError
+        nil
+      end.uniq
+    rescue Errno::ENOENT
+      raise "the ip command is required for the libvirt network preflight"
+    end
+  end
+end
